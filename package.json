{
  "name": "damjachai",
  "private": true,
  "version": "0.0.0",
  "description": "DamJachai (দাম যাচাই) - compare diagnostic test prices across labs in Bangladesh",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "db:create": "npm run db:create -w server",
    "migrate": "npm run migrate -w server",
    "seed": "npm run seed -w server",
    "db:reset": "npm run db:reset -w server",
    "test:client": "npm run test -w client"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "jsdom": "^26.1.0"
  },
  "overrides": {
    "jsdom": "^26.1.0"
  }
}
